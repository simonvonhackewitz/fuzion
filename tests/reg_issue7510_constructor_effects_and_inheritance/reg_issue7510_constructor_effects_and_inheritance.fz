#  Source code of Fuzion test reg_issue7510_constructor_effects_and_inheritance
#
# -----------------------------------------------------------------------

# Regression test for #7510: inheritance and '!' for effects conflict when
# defining a constructor.
#
# The syntax
#
#   ex (M type : mutate) ! M : some_feat is
#
# must be parsed as a constructor `ex` with a formal type argument `M` bounded
# by `mutate`, an effect annotation `! M` and an inheritance declaration
# `: some_feat`.  The parser must not consume the ':' following 'M' for
# inheritance as part of the effect type `M`.
#
reg_issue7510_constructor_effects_and_inheritance =>

  parent7510 is

  ex7510 (M type : mutate) ! M : parent7510 is

    public tag i32 => 42

  t := ex7510 mutate
  say "tag=$(t.tag)"